<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="cloud cloud1"></div>
    <div class="cloud cloud2"></div>
    <div class="cloud cloud3"></div>
    <div class="petal" style="left:20%; animation-duration:10s; animation-delay:0s;"></div>
    <div class="petal" style="left:40%; animation-duration:8s; animation-delay:2s;"></div>
    <div class="petal" style="left:60%; animation-duration:11s; animation-delay:1s;"></div>
    <div class="petal" style="left:85%; animation-duration:9s; animation-delay:3s;"></div>

    <div class="navbar">
        <div class="brand">Cozy Boarding House</div>
        <div class="nav-links">
            <a href="/add_user">Add</a>
            <a href="/user_list">Tenants</a>
        </div>
    </div>

    <div class="container">
        <h1>Update Tenant</h1>
        <% sampledata.forEach(function(item) { %>
        <form action="/update_user/<%= item.id %>" method="POST">
            <label>First Name</label>
            <input type="text" name="fn" value="<%= item.fn %>" required>

            <label>Last Name</label>
            <input type="text" name="ln" value="<%= item.ln %>" required>

            <label>Address</label>
            <input type="text" name="address" value="<%= item.address %>" required>

            <label>Email</label>
            <input type="email" name="email" value="<%= item.email %>" required>

            <label>Password</label>
            <input type="password" name="password" value="<%= item.password %>" required>

            <label>Contact Number</label>
            <input type="text" name="cn" value="<%= item.cn %>" required>

            <button type="submit">Update Tenant</button>
        </form>
        <% }); %>
        <a href="/user_list">Back to List</a>
    </div>
</body>
</html>
