<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="cloud cloud1"></div>
    <div class="cloud cloud2"></div>
    <div class="cloud cloud3"></div>
    <div class="petal" style="left:10%; animation-duration:8s; animation-delay:0s;"></div>
    <div class="petal" style="left:25%; animation-duration:10s; animation-delay:2s;"></div>
    <div class="petal" style="left:45%; animation-duration:9s; animation-delay:4s;"></div>
    <div class="petal" style="left:65%; animation-duration:11s; animation-delay:1s;"></div>
    <div class="petal" style="left:80%; animation-duration:7s; animation-delay:3s;"></div>
    <div class="petal" style="left:95%; animation-duration:12s; animation-delay:5s;"></div>

    <div class="navbar">
        <div class="brand">Cozy Boarding House</div>
        <div class="nav-links">
            <a href="/add_user">Add</a>
            <a href="/user_list">Tenants</a>
        </div>
    </div>

    <div class="container">
        <h1>Add Tenant</h1>
        <form action="/add_user" method="POST">
            <label>First Name</label>
            <input type="text" name="fn" placeholder="Enter first name" required>

            <label>Last Name</label>
            <input type="text" name="ln" placeholder="Enter last name" required>

            <label>Address</label>
            <input type="text" name="address" placeholder="Enter address" required>

            <label>Email</label>
            <input type="email" name="email" placeholder="Enter email" required>

            <label>Password</label>
            <input type="password" name="password" placeholder="Enter password" required>

            <label>Contact Number</label>
            <input type="text" name="cn" placeholder="Enter contact number" required>

            <button type="submit">Add Tenant</button>
        </form>
        <a href="/user_list">View Tenant List</a>
    </div>
</body>
</html>
