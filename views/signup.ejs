<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="cloud cloud1"></div>
    <div class="cloud cloud2"></div>
    <div class="cloud cloud3"></div>
    <div class="petal" style="left:10%; animation-duration:8s; animation-delay:0s;"></div>
    <div class="petal" style="left:25%; animation-duration:10s; animation-delay:2s;"></div>
    <div class="petal" style="left:45%; animation-duration:9s; animation-delay:4s;"></div>
    <div class="petal" style="left:65%; animation-duration:11s; animation-delay:1s;"></div>
    <div class="petal" style="left:80%; animation-duration:7s; animation-delay:3s;"></div>
    <div class="petal" style="left:95%; animation-duration:12s; animation-delay:5s;"></div>

    <div class="login-wrapper">
        <div class="login-card signup-card">
            <div class="login-icon">&#128100;</div>
            <h1>Create Account</h1>
            <p class="login-sub">Sign up to join Cozy Boarding House</p>

            <form action="/add_user" method="POST">
                <div class="form-row">
                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" name="fn" placeholder="First name" required>
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" name="ln" placeholder="Last name" required>
                    </div>
                </div>

                <label>Address</label>
                <input type="text" name="address" placeholder="Enter address" required>

                <label>Email</label>
                <input type="email" name="email" placeholder="Enter email" required>

                <label>Password</label>
                <input type="password" name="password" placeholder="Create password" required>

                <label>Contact Number</label>
                <input type="text" name="cn" placeholder="Enter contact number" required>

                <button type="submit">Sign Up</button>
            </form>

            <p class="login-footer">Already have an account? <a href="/login">Login</a></p>
        </div>
    </div>
</body>
</html>
